        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}-{1}', parameters('namePrefix'), variables('suffix')))]",
        "IngestionMode": "LogAnalytics",
        "RetentionInDays": 30
      },
      "dependsOn": [
