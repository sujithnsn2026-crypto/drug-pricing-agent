        "enabled": true,
        "emailReceivers": [
          {
            "name": "owner",
            "emailAddress": "[parameters('alertEmail')]",
            "useCommonAlertSchema": true
          }
        ]
      }
    },
    {
      "condition": "[not(empty(parameters('alertEmail')))]",
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-03-15-preview",
      "name": "[format('alert-{0}-ungrounded-answers', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "displayName": "DPA agent: ungrounded numbers above 5% (1h)",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[resourceId('Microsoft.Insights/components', format('appi-{0}-{1}', parameters('namePrefix'), variables('suffix')))]"
        ],
        "evaluationFrequency": "PT1H",
        "windowSize": "PT1H",
        "criteria": {
          "allOf": [
            {
              "query": "dependencies | where name == \"invoke_agent dpa-ask\" | where tostring(customDimensions[\"dpa.status\"]) == \"answered\" | summarize n = count(), ungrounded = countif(toint(customDimensions[\"dpa.grounding.ungrounded\"]) > 0) | where n >= 20 and 1.0 * ungrounded / n > 0.05",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": [
            "[resourceId('Microsoft.Insights/actionGroups', format('ag-{0}-llmops', parameters('namePrefix')))]"
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', format('ag-{0}-llmops', parameters('namePrefix')))]",
        "[resourceId('Microsoft.Insights/components', format('appi-{0}-{1}', parameters('namePrefix'), variables('suffix')))]"
      ]
    }
