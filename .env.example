# Copy to .env (git-ignored) and fill in.
# Keyless (recommended, and the only option on the Step 10 deployment, which has keys disabled):
#   leave AZURE_OPENAI_API_KEY empty, run `az login`; the client signs in with Microsoft Entra ID.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
DPA_MODEL=gpt-4.1-mini
# Application Insights -> Overview -> Connection string (optional: traces go to App Insights too)
APPLICATIONINSIGHTS_CONNECTION_STRING=
# DPA_TRACE_CONTENT=true   # include question/answer text in traces (off by default)
