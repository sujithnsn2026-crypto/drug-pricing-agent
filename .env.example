# Copy to .env (git-ignored) and fill in. Values come from the Azure portal:
#   Azure OpenAI resource -> Keys and Endpoint;  Application Insights -> Overview -> Connection string
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
DPA_MODEL=gpt-4.1-mini
APPLICATIONINSIGHTS_CONNECTION_STRING=
# DPA_TRACE_CONTENT=true   # include question/answer text in traces (off by default)
